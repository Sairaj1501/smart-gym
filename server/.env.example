# Copy to .env and fill in. Never commit .env.
PORT=5000
NODE_ENV=development
# Local: mongodb://127.0.0.1:27017/smart_gym   Atlas: mongodb+srv://<user>:<password>@<cluster>/smart_gym
MONGODB_URI=mongodb://127.0.0.1:27017/smart_gym
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173
# --- Optional: AI narration + chatbot. Leave blank to use the rule-based fallback. ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
